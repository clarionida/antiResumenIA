    "https://www.google.com.cu/*",
    "https://www.google.gq/*",
    "https://www.google.ad/*",
    "https://www.google.com.br/*",
    "https://www.google.pt/*",
    "https://www.google.co.ao/*",
    "https://www.google.co.mz/*",
    "https://www.google.cv/*",
    "https://www.google.co.uk/*",
    "https://www.google.ca/*",
    "https://www.google.com.au/*",
    "https://www.google.co.nz/*",
    "https://www.google.ie/*",
    "https://www.google.co.in/*",
    "https://www.google.co.za/*",
    "https://www.google.de/*",
    "https://www.google.fr/*",
    "https://www.google.it/*",
    "https://www.google.nl/*",
    "https://www.google.be/*",
    "https://www.google.ch/*",
    "https://www.google.at/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/*",
        "https://www.google.com.mx/*",
        "https://www.google.es/*",
        "https://www.google.com.ar/*",
