        "https://www.google.fr/*",
        "https://www.google.it/*",
        "https://www.google.nl/*",
        "https://www.google.be/*",
        "https://www.google.ch/*",
        "https://www.google.at/*"
      ],
      "include_globs": [
        "*://www.google.*/search*",
        "*://www.google.*/",
        "*://www.google.*/webhp*"
      ],
      "js": [
        "src/config.js",
        "src/common.js",
        "src/content/content.js"
      ],
      "css": [
        "src/content/content.css"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
